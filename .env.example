# ============================================================
# 케이스랩 환경변수 — “돈 0원 출시” 모드 기준 (2026-06-01)
# ============================================================

# ─── 필수 (Day 1 Supabase 가입 후 채움) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── 필수 (Day 10 Vercel 배포 후 채움) ───
# 무료 서브도메인 사용 시: https://caselab.vercel.app (Vercel이 정함)
# 커스텀 도메인 도입 시: https://caselab.kr 같이 변경
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Draft Preview 토큰 (`openssl rand -hex 32`로 생성)
DRAFT_PREVIEW_SECRET=change-this-to-random-32-chars

# ─── 선택 (GA4 — Day 8 출시 직전 활성) ───
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Kakao OAuth ───
# 2026-06-08: Supabase 기본 Kakao provider로 전환(§18.12). 키는 Supabase Dashboard
# → Authentication → Providers → Kakao 에 입력하므로 앱 env로는 불필요.
# (아래 2개는 폐기된 Edge Function kakao-oauth 용 잔재 — 신규 셋업 시 무시)
# KAKAO_REST_API_KEY=your-kakao-rest-api-key
# KAKAO_CLIENT_SECRET=your-kakao-client-secret

# ─── 전자책 발송 (Day 9 — Brevo HTTP API, Supabase Edge Function secrets로 등록) ───
# Brevo dashboard → Senders → Add a sender (caselab.kr@gmail.com 단일 발신자 인증)
# Brevo dashboard → SMTP & API → API Keys → Generate (형식: xkeysib-...)
# (Vercel 환경변수에는 등록 안 함. supabase secrets set ... 로만 등록)
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=caselab.kr@gmail.com
# BREVO_SENDER_NAME=케이스랩

# ─── 뉴스레터 동기화 (sync-brevo-contact Edge Function, 2026-06-10) ───
# Brevo Contacts → Lists 의 숫자 ID (prod = 3 caselab-newsletter)
# BREVO_NEWSLETTER_LIST_ID=3
# 트리거가 함수를 호출하는 데 필요한 시크릿은 .env가 아니라 Supabase Vault에 저장:
#   select vault.create_secret('https://<ref>.supabase.co/functions/v1/sync-brevo-contact', 'sync_brevo_url');
#   select vault.create_secret('<SERVICE_ROLE_KEY>', 'service_role_key');
#   (Supabase 관리형은 ALTER DATABASE SET app.* 가 막혀 GUC 대신 Vault 사용)

# ─── 출시 후 도입 (지금은 활성 X) ───
# Anthropic Claude — AI 초안 버튼 도입 시 활성화
# 활성화하려면 두 변수 모두 채우고 NEXT_PUBLIC_AI_DRAFT_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-xxx
# NEXT_PUBLIC_AI_DRAFT_ENABLED=true
